{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .banner__text.body.hide--on-desktop,
  .banner__buttons.hide--on-desktop.banner__buttons--multiple.banner__buttons--custom {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hide--on-desktop {
      display: block;
    }

    .banner__text.body.hide--on-desktop {
      display: block;
    }
    
    .hide--on-mobile {
      display: none !important;
    }
  }

  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
  {%- unless section.settings.heading_font_override == 'global' -%}
    #Banner-{{ section.id }} {
      {%- if section.settings.heading_font_override == 'canopee' -%}
        --font-heading-family: 'Canopee', sans-serif;
      {%- elsif section.settings.heading_font_override == 'caslon' -%}
        --font-heading-family: 'Caslon Ionic', serif;
      {%- endif -%}
    }
  {%- endunless -%}


  #Banner-{{ section.id }} {
    --font-heading-scale: {{ section.settings.heading_scale_override | divided_by: 100.0 }};
    --font-body-scale: {{ section.settings.body_scale_override | divided_by: 100.0 }};
  }

  /* Ensure banner text uses the local --font-body-scale instead of fixed rems */
  #Banner-{{ section.id }} .banner__text {
    font-size: calc(var(--font-body-base) * var(--font-body-scale));
  }

  #Banner-{{ section.id }} .banner__text span {
    {%- if section.settings.body_font_override == 'canopee' -%}
      font-family: 'Canopee', sans-serif;
    {%- elsif section.settings.body_font_override == 'caslon' -%}
      font-family: 'Caslon Ionic', serif;
    {%- endif -%}
  }

  @media screen and (min-width: 768px) {
    #Banner-{{ section.id }} .banner__text span {
      font-size: calc(var(--font-body-base) * var(--font-body-scale));
    }
  }


{%- endstyle -%}

{% assign has_content_blocks = false %}
{% if section.blocks.size > 0 %}
  {% assign has_content_blocks = true %}
{% endif %}

{% assign desktop_image_1 = section.settings.image %}
{% assign desktop_image_2 = section.settings.image_2 %}

{% assign mobile_image_1 = section.settings.image_mobile %}
{% if mobile_image_1 == blank %}
  {% assign mobile_image_1 = desktop_image_1 %}
{% endif %}

{% assign mobile_image_2 = section.settings.image_2_mobile %}
{% if mobile_image_2 == blank %}
  {% assign mobile_image_2 = desktop_image_2 %}
{% endif %}
{% if mobile_image_2 == blank %}
  {% assign mobile_image_2 = mobile_image_1 %}
{% endif %}

{% assign has_two_images = false %}
{% if section.settings.image_2 != blank %}
  {% assign has_two_images = true %}
{% elsif section.settings.image_2_mobile != blank %}
  {% assign has_two_images = true %}
{% endif %}

{% assign has_first_image = false %}
{% if desktop_image_1 != blank %}
  {% assign has_first_image = true %}
{% elsif section.settings.image_mobile != blank %}
  {% assign has_first_image = true %}
{% endif %}

{% assign has_second_image = false %}
{% if desktop_image_2 != blank %}
  {% assign has_second_image = true %}
{% elsif section.settings.image_2_mobile != blank %}
  {% assign has_second_image = true %}
{% endif %}

<div id="Banner-{{ section.id }}" class="banner--image banner color-{{ section.settings.color_scheme }} gradient banner--content-align-{{ section.settings.desktop_content_position | replace: 'middle-' }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--large{% if section.settings.stack_images_on_mobile %} banner--stacked{% endif %}{% if has_two_images %} banner--has-two-images banner--mobile-prioritize-second{% endif %}{% unless has_content_blocks %} banner--no-blocks{% endunless %} banner--mobile-bottom">
  {%- if has_first_image -%}
    <div class="banner__media media{% if desktop_image_2 != blank %} banner__media-half{% endif %} first-image">
      {%- liquid
        if desktop_image_1 != blank
          assign image_height = desktop_image_1.width | divided_by: desktop_image_1.aspect_ratio
        else
          assign image_height = mobile_image_1.width | divided_by: mobile_image_1.aspect_ratio
        endif

        assign image_class = ''
        if desktop_image_2 != blank
          assign image_class = "banner__media-image-half"
        endif
        assign desktop_image_1_class = image_class | append: ' banner__image--desktop'
        assign mobile_image_1_class = image_class | append: ' banner__image--mobile'

        if desktop_image_2 != blank
          assign sizes = "(min-width: 768px) 50vw, 100vw"
        else
          assign sizes = "100vw"
        endif
        assign mobile_sizes = "100vw"

        if mobile_image_1 != blank
          assign mobile_image_height_1 = mobile_image_1.width | divided_by: mobile_image_1.aspect_ratio
        endif
      -%}

      {%- if desktop_image_1 != blank -%}
        {{ desktop_image_1 | image_url: width: 1500 | image_tag:
          loading: 'lazy',
          width: desktop_image_1.width,
          height: image_height,
          class: desktop_image_1_class,
          sizes: sizes,
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: desktop_image_1.alt | escape
        }}
      {%- endif -%}

      {%- if mobile_image_1 != blank -%}
        {{ mobile_image_1 | image_url: width: 1500 | image_tag:
          loading: 'lazy',
          width: mobile_image_1.width,
          height: mobile_image_height_1,
          class: mobile_image_1_class,
          sizes: mobile_sizes,
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: mobile_image_1.alt | escape
        }}
      {%- endif -%}
    </div>
  {%- elsif has_second_image == false -%}
    <div class="banner__media media placeholder second-image">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if has_second_image -%}
    <div class="banner__media media{% if desktop_image_2 != blank and desktop_image_1 != blank %} banner__media-half{% endif %} second-image{% if desktop_image_2 == blank %} mobile-only-image{% endif %}">
      {%- liquid
        assign image_class_2 = ''
        if desktop_image_2 != blank
          assign image_height_2 = desktop_image_2.width | divided_by: desktop_image_2.aspect_ratio
          assign image_class_2 = "banner__media-image-half"
        endif
        if desktop_image_2 != blank
          assign sizes = "(min-width: 768px) 50vw, 100vw"
        else
          assign sizes = "100vw"
        endif
        assign mobile_sizes = "100vw"

        assign desktop_image_2_class = image_class_2 | append: ' banner__image--desktop'
        assign mobile_image_2_class = image_class_2 | append: ' banner__image--mobile'

        if mobile_image_2 != blank and desktop_image_2 == blank
          assign image_height_2 = mobile_image_2.width | divided_by: mobile_image_2.aspect_ratio
        endif
      -%}

      {%- if desktop_image_2 != blank -%}
        {{ desktop_image_2 | image_url: width: 1500 | image_tag:
          loading: 'lazy',
          width: desktop_image_2.width,
          height: image_height_2,
          class: desktop_image_2_class,
          sizes: sizes,
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: desktop_image_2.alt | escape
        }}
      {%- endif -%}

      {%- if mobile_image_2 != blank -%}
        {{ mobile_image_2 | image_url: width: 1500 | image_tag:
          loading: 'lazy',
          width: mobile_image_2.width,
          height: image_height_2,
          class: mobile_image_2_class,
          sizes: mobile_sizes,
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: mobile_image_2.alt | escape
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
  {% if has_content_blocks %}
    <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width blocks_container">
      {%- assign scheme = section.settings.color_scheme -%}
      {% assign section_layout_class = '' %}

      {% if section.blocks.size == 1 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'buttons' %}
              {% assign section_layout_class = 'section--button-only' %}
            {% when 'heading' %}
              {% assign section_layout_class = 'section--heading-only' %}
            {% when 'text' %}
              {% assign section_layout_class = 'section--text-only' %}
          {% endcase %}
        {% endfor %}
      {% endif %}

    <div class="banner__box content-container content-container--full-width-mobile color-{{ scheme }} {{ section_layout_class }}" style="--color-foreground: {{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }}; --color-button: {{ scheme.settings.button.red }}, {{ scheme.settings.button.green }}, {{ scheme.settings.button.blue }}; --color-button-text: {{ scheme.settings.button_label.red }}, {{ scheme.settings.button_label.green }}, {{ scheme.settings.button_label.blue }}; color: rgb(var(--color-foreground)); background-color: transparent;">

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {% style %}
              {% if block.settings.custom_heading_positioning %}
                #Banner-{{ section.id }} .banner__heading.custom-heading-positioning {
                  text-align: {{ block.settings.heading_alignment }};
                  width: 100%;
                  display: flex;
                  justify-content: {{ block.settings.heading_alignment }};
                  align-items: {{ block.settings.heading_align_item_position }};
                }

                @media screen and (min-width: 750px) {
                  #Banner-{{ section.id }} .banner__box.section--heading-only {
                    max-width: 500px;
                    width: 100%;
                  }
                }

                @media screen and (max-width: 749px) {
                  #Banner-{{ section.id }} .banner__heading.custom-heading-positioning {
                    text-align: {{ block.settings.heading_alignment_mobile }};
                    width: 100%;
                    display: flex;
                    justify-content: {{ block.settings.heading_alignment_mobile }};
                    align-items: {{ block.settings.heading_align_item_position_mobile }};
                  }
                }
              {% endif %}

              {% unless section.settings.stack_images_on_mobile %}
                @media screen and (max-width: 767px) and (min-width: 750px) {
                  #Banner-{{ section.id }} .banner__box {
                    max-width: none;
                  }
                }

              {% endunless %}
            {% endstyle %}
            <h2 class="banner__heading {{ block.settings.heading_size }} {% if block.settings.custom_heading_positioning %}custom-heading-positioning{% endif %}" {{ block.shopify_attributes }}>
              <span>{{ block.settings.heading | newline_to_br }}</span>
            </h2>
          {%- when 'text' -%}
            <div class="banner__text body hide--on-mobile" {{ block.shopify_attributes }}>
              <span>{{ block.settings.text | newline_to_br }}</span>
            </div>
            {% if block.settings.custom_text_positioning %}
              <style>
                {% if section_layout_class == 'section--text-only' %}
                  .banner__content .banner__box.content-container.section--text-only {
                    display: flex;
                    width: 100%;
                    justify-content: {{ block.settings.text_vertical_alignment }};
                  }
                {% endif %}
                #Banner-{{ section.id }} .banner__text.body.hide--on-mobile {
                  text-align: {{ block.settings.text_alignment }};
                  width: 100%;
                  max-width: 100%;
                }
                
                @media screen and (max-width: 749px) {
                  #Banner-{{ section.id }} .banner__text {
                    text-align: {{ block.settings.text_alignment_mobile }};
                    width: 100%;
                  }
                }
              </style>
            {% endif %}
          {%- when 'buttons' -%}
            <div class="banner__buttons hide--on-mobile{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %} banner__buttons--custom" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a{% if block.settings.button_link_1 != blank %} href="{{ block.settings.button_link_1 }}"{% endif %} class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %} button_number_1">{{ block.settings.button_label_1 | escape }}</a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a{% if block.settings.button_link_2 != blank %} href="{{ block.settings.button_link_2 }}"{% endif %} class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %} button_number_2">{{ block.settings.button_label_2 | escape }}</a>
              {%- endif -%}

            </div>
            <style>

              {% if section_layout_class == 'section--button-only' %}
                .banner__box.content-container.section--button-only {
                  display: flex;
                  width: 100%;
                  justify-content: {{ block.settings.button_vertical_alignment }};
                }
              {% endif %}

              {% if block.settings.enable_custom_button_styles == true %}
                
                #Banner-{{ section.id }} .banner__box .button_number_1 {
                  background-color: {{ block.settings.button_color }};
                  color: {{ block.settings.button_text_color }};
                  border: {{ block.settings.button_outline_color }} {{ block.settings.button_border_width }}px solid;
                }
                #Banner-{{ section.id }} .banner__box .button_number_2 {
                  background-color: {{ block.settings.button_color_2 }};
                  color: {{ block.settings.button_text_color_2 }};
                  border: {{ block.settings.button_outline_color_2 }} {{ block.settings.button_border_width_2 }}px solid;
                }

                .button::after {
                  box-shadow: none;
                }

                .button:not([disabled]):hover:after {
                  box-shadow: none;
                }
              {% endif %}
                @media screen and (min-width: 750px) {
                  #Banner-{{ section.id }} .banner__buttons--custom {
                    display: flex;
                    max-width: none;
                    width: 100%;
                    justify-content: {{ block.settings.button_alignment }};
                  }

                  #Banner-{{ section.id }} .banner__buttons .button {
                    max-width: 180px;
                  }

                  #mobile_buttons.hide--on-desktop {
                    display: none;
                  }
                }
            </style>

            <div class="blocks__container hide--on-desktop color-{{ section.settings.color_scheme }}">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'text' -%}
                    <div class="banner__text body hide--on-desktop" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.text | newline_to_br }}</span>
                    </div>
                    {% if block.settings.custom_text_positioning %}
                      <style>
                        .blocks__container .banner__text[data-block-id="{{ block.id }}"] {
                          text-align: {{ block.settings.text_alignment }};
                          width: 100%;
                          max-width: 100%;
                        }
                        
                        @media screen and (max-width: 749px) {

                          .blocks__container .banner__text {
                            text-align: {{ block.settings.text_alignment_mobile }};
                            width: 100%;
                          }

                          .banner__text.body.hide--on-desktop {
                            padding-bottom: 15px;
                          }
                        }
                      </style>
                    {% endif %}
                  {%- when 'buttons' -%}
                    <div id="mobile_buttons" class="banner__buttons hide--on-desktop{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %} banner__buttons--custom" {{ block.shopify_attributes }}>
                      {%- if block.settings.button_label_1 != blank -%}
                        <a{% if block.settings.button_link_1 != blank %} href="{{ block.settings.button_link_1 }}"{% endif %} class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %} button_number_1">{{ block.settings.button_label_1 | escape }}</a>
                      {%- endif -%}
                      {%- if block.settings.button_label_2 != blank -%}
                        <a{% if block.settings.button_link_2 != blank %} href="{{ block.settings.button_link_2 }}"{% endif %} class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %} button_number_2">{{ block.settings.button_label_2 | escape }}</a>
                      {%- endif -%}
                    </div>
                    <style>
                      {% if block.settings.enable_custom_button_styles == true %}
                        .blocks__container .button_number_1 {
                          background-color: {{ block.settings.button_color }};
                          color: {{ block.settings.button_text_color }};
                          border: {{ block.settings.button_outline_color }} {{ block.settings.button_border_width }}px solid;
                        }
                        .blocks__container .button_number_2 {
                          background-color: {{ block.settings.button_color_2 }};
                          color: {{ block.settings.button_text_color_2 }};
                          border: {{ block.settings.button_outline_color_2 }} {{ block.settings.button_border_width_2 }}px solid;
                        }
                      {% endif %}

                        .button::after {
                          box-shadow: none;
                        }

                        .button:not([disabled]):hover:after {
                          box-shadow: none;
                        }

                        .blocks__container .banner__buttons--custom {
                          display: none;
                        }
                        
                        @media screen and (max-width: 750px) {
                          .blocks__container #mobile_buttons.banner__buttons--custom {
                            display: flex;
                            max-width: none;
                            width: 100%;
                            justify-content: {{ block.settings.button_alignment_mobile }};
                          }

                          .blocks__container #mobile_buttons.banner__buttons .button {
                            width: 100%;
                            max-width: 150px;
                            padding: 0;
                            min-width: auto;
                          }

                          .blocks__container {
                            width: 100%;
                          }
                        }

                        @media screen and (max-width: 340px) {
                          .blocks__container #mobile_buttons.banner__buttons .button {
                            max-width: unset;
                          }
                        }
                    </style>

                {%- endcase -%}
              {%- endfor -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {% endif %}
</div>


{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Desktop images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "First image (desktop)",
      "info": "Used on desktop/tablet screens. If no mobile first image is added, this image will also be used on mobile."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image (desktop)",
      "info": "Optional. Used as the second desktop image when creating a two-image banner. If no mobile second image is added, this image can also be used on mobile."
    },
    {
      "type": "header",
      "content": "Mobile images"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "First image (mobile)",
      "info": "Optional. Used on screens 767px wide and below. If blank, the first desktop image will be used as the fallback."
    },
    {
      "type": "image_picker",
      "id": "image_2_mobile",
      "label": "Second image (mobile)",
      "info": "Optional. Used on screens 767px wide and below when a second mobile image is needed. If blank, the second desktop image will be used. If no second desktop image exists, the first image fallback will be used."
    },
    {
      "type": "checkbox",
      "id": "stack_images_on_mobile",
      "default": true,
      "label": "t:sections.image-banner.settings.stack_images_on_mobile.label",
      "visible_if": "{{ section.settings.image_2 != blank }}"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "middle-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.image-banner.settings.desktop_content_position.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Typography"
    },
    {
      "type": "select",
      "id": "heading_font_override",
      "label": "Heading font",
      "options": [
        { "value": "global", "label": "Use global setting" },
        { "value": "canopee", "label": "Canopee (custom)" },
        { "value": "caslon", "label": "Caslon Ionic (custom)" }
      ],
      "default": "global"
    },
    {
      "type": "range",
      "id": "heading_scale_override",
      "min": 75,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "t:settings_schema.typography.settings.heading_scale.label",
      "default": 100
    },
    {
      "type": "select",
      "id": "body_font_override",
      "label": "Body font",
      "options": [
        { "value": "global", "label": "Use global setting" },
        { "value": "canopee", "label": "Canopee (custom)" },
        { "value": "caslon", "label": "Caslon Ionic (custom)" }
      ],
      "default": "global"
    },
    {
      "type": "range",
      "id": "body_scale_override",
      "min": 75,
      "max": 130,
      "step": 5,
      "unit": "%",
      "label": "t:settings_schema.typography.settings.body_scale.label",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "header",
          "content": "Text Positioning"
        },
        {
          "type": "checkbox",
          "id": "custom_heading_positioning",
          "default": false,
          "label": "Enable custom heading positioning"
        },
        {
          "type": "select",
          "id": "heading_alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Heading alignment"
        },
        {
          "type": "select",
          "id": "heading_align_item_position",
          "options": [
            { "value": "flex-start", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Bottom" }
          ],
          "default": "flex-start",
          "label": "Heading vertical alignment"
        },
        {
          "type": "select",
          "id": "heading_alignment_mobile",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Heading alignment (mobile)"
        },
        {
          "type": "select",
          "id": "heading_align_item_position_mobile",
          "options": [
            { "value": "flex-start", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Bottom" }
          ],
          "default": "flex-start",
          "label": "Heading vertical alignment (mobile)"
