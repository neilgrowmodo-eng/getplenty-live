    "image_with_text_KFPWwx": {
      "type": "image-with-text",
      "blocks": {
        "text_QkPVGX": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Q:</strong> What’s next for your practice? Anything you’ve been wanting to try but haven’t yet?</p><p><strong>A: </strong>Right now I’m really interested in continuing to expand on large closed forms, which also act as rattles. I’m playing with the idea of sound and ceramics, and a performative aspect to activate the pieces. </p><p>I’ve also wanted to try to emulate Interior Salish baskets in clay form. I’ve done some travel and research in NYC, Seattle and Vancouver, looking at Shuswap baskets from different Museum’s collections. In the future it could be fun to build a small collection around my research and what I saw.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
